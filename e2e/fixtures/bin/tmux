#!/usr/bin/env bash
# E2E 用の偽 tmux。
#
# 本物の tmux を呼ぶとテストが非決定的になる（実行中の実セッションを拾う、
# E2E 実行のたびにセッションが衝突する等）うえ、本物の tmux は代替画面
# バッファへ切り替える（ESC [ ? 1049 h）ため、xterm 側のスクロールバックが
# 実装と無関係な理由で変化する。PATH の先頭にこのスクリプトを置いて差し替える。
#
# 重要: 受け取るのは常に
#   new-session -A -s <sessionName> -- <command> <args...>
# の形（src/main/pty/tmux.ts の wrapCommandWithTmux が組み立てる）。
# `-- ` より後ろをそのまま exec することで、ラップの中身（本物の claude /
# gemini の起動）まで含めて動かす。
#
# セッション名は ${AI_TERMINAL_E2E_FIXTURES}/tmux-session-name.txt に書き出す。
# spec 側はこのファイルを読むことで、アプリが渡した tmux セッション名
# （aiterm-<agentSessionId> の形）を検証できる。
#
# このシムで担保できないこと（本物の tmux との差）:
# - 代替画面バッファへの切り替えは行わない。
# - セッションの永続化は再現しない（このプロセスは exec するだけで、
#   親プロセスを kill してもセッションが生き残る、という tmux 本来の
#   挙動は無い）。
# - `-A`（同名セッションがあれば attach、無ければ new-session）の分岐は
#   検証していない。常に「新規にコマンドを exec する」動きしかしない。
# - `attach-session` には応答しない（アプリは `-A` 経由でしかアタッチしない）。
#
# list-sessions は上記と別に扱う（下を参照）。**一覧の中身はフィクスチャが決める**ので、
# 「アプリが一覧をどう読むか」は検証できるが、「実際にアタッチできるか」は検証できない。
#
# kill-session も同じ枠組みで扱う（Issue #244）。**このシムは exec するだけなので
# 「生きているセッション」の実体を持たない。** 生存を表しているのは
# tmux-live-panes.txt というフィクスチャのほうなので、kill-session は
# **そのフィクスチャから該当行を落とす**ことで「セッションが消えた」を表現する。

set -uo pipefail

# list-sessions: 生きているセッションの一覧。
# アプリ（poller.ts -> tmuxSessions.ts）が3秒ごとに叩く。
# ${AI_TERMINAL_E2E_FIXTURES}/tmux-live-sessions.txt があればその中身を返し、
# 無ければ本物の tmux が「サーバが動いていない」ときと同じく非ゼロで終わる。
# spec 側はこのファイルを書くことで「セッションが生き残っている」状態を作れる。
# list-panes: 生きているセッションの要約（session_name / 起動コマンド / cwd）。
# アプリ（poller.ts -> tmuxSessions.ts）が3秒ごとに叩く。
# ${AI_TERMINAL_E2E_FIXTURES}/tmux-live-panes.txt の中身をそのまま返す。
# **区切りは 0x1f**（実装の FIELD_SEPARATOR と合わせること）。
if [ "${1:-}" = "list-panes" ]; then
  live="${AI_TERMINAL_E2E_FIXTURES:-}/tmux-live-panes.txt"
  if [ -n "${AI_TERMINAL_E2E_FIXTURES:-}" ] && [ -f "$live" ]; then
    cat "$live"
    exit 0
  fi
  echo "no server running" >&2
  exit 1
fi

if [ "${1:-}" = "list-sessions" ]; then
  live="${AI_TERMINAL_E2E_FIXTURES:-}/tmux-live-sessions.txt"
  if [ -n "${AI_TERMINAL_E2E_FIXTURES:-}" ] && [ -f "$live" ]; then
    cat "$live"
    exit 0
  fi
  echo "no server running" >&2
  exit 1
fi

# kill-session -t <sessionName>: セッションを終了する（Issue #244）。
#
# 受けた名前は ${AI_TERMINAL_E2E_FIXTURES}/tmux-killed-sessions.txt へ**追記**する。
# spec 側はこのファイルを読むことで「アプリが実際に kill-session を叩いたか」を検証できる。
# ⭐ **成否によらず必ず記録する。** 記録しているのは「アプリが何を要求したか」で、
# tmux 側の結果ではない。ここを成功時だけにすると、**縮退した（諦めた）実装と
# 呼んですらいない実装が区別できなくなる**。
#
# あわせて tmux-live-panes.txt から該当行を落とす（このシムでの「セッションの生存」は
# あのファイルが唯一の正なので、消さないと「終了したのに一覧に残る」が再現できない）。
#
# ⛔⛔ **記録は必ず最後に書く。順序に意味がある。**
# spec は `expect.poll(readKilled)` で「叩かれた」を待ってから、live-panes を**同期で**
# 確かめる。記録を先に書くと、**poll が緑になった時点でまだ live-panes を書き換えて
# いない**瞬間があり、直後の同期 assert が理由不明で落ちる（フレークになる）。
# design-review の保守レビュー（2026-08-09）が指摘し、順序を入れ替えた。
#
# 終了ステータスは本物に合わせる: 見つかれば 0、無ければ非ゼロ + `can't find session`。
# **アプリはこの非ゼロで落ちてはいけない**（tmux が既に死んでいる場合が普通にある）。
if [ "${1:-}" = "kill-session" ]; then
  target=""
  kill_args=("$@")
  j=1
  while [ "$j" -lt "$#" ]; do
    if [ "${kill_args[$j]}" = "-t" ]; then
      j=$((j + 1))
      target="${kill_args[$j]:-}"
      break
    fi
    j=$((j + 1))
  done

  killed=1
  live="${AI_TERMINAL_E2E_FIXTURES:-}/tmux-live-panes.txt"
  if [ -n "${AI_TERMINAL_E2E_FIXTURES:-}" ] && [ -f "$live" ] && [ -n "$target" ]; then
    # 第1フィールド（#{session_name}）が一致する行だけを落とす。区切りは 0x1f。
    #
    # ⛔ **`-F'\x1f'` と書かないこと。** macOS の awk（BSD awk）は `\x` エスケープを
    # 解釈しないので、区切りが「バックスラッシュ・x・1・f のいずれかの1文字」になり、
    # **一致しないまま静かに失敗する**（2026-08-09 に実際に踏んだ）。
    # bash の ANSI-C 引用（`$'\037'`）でバイトそのものを渡す。
    sep=$'\037'
    if awk -F"$sep" -v t="$target" '$1 == t { found = 1 } END { exit found ? 0 : 1 }' "$live"; then
      awk -F"$sep" -v t="$target" '$1 != t' "$live" > "$live.tmp" && mv "$live.tmp" "$live"
      killed=0
    fi
  fi

  # ここで初めて記録する（上の ⛔ を参照）。
  if [ -n "${AI_TERMINAL_E2E_FIXTURES:-}" ]; then
    printf '%s\n' "$target" >> "${AI_TERMINAL_E2E_FIXTURES}/tmux-killed-sessions.txt"
  fi

  if [ "$killed" -eq 0 ]; then
    exit 0
  fi
  echo "can't find session: $target" >&2
  exit 1
fi

session=""
args=("$@")
command_args=()
found_separator=0

i=0
while [ "$i" -lt "$#" ]; do
  arg="${args[$i]}"
  if [ "$found_separator" -eq 1 ]; then
    command_args+=("$arg")
  elif [ "$arg" = "-s" ]; then
    i=$((i + 1))
    session="${args[$i]:-}"
  elif [ "$arg" = "--" ]; then
    found_separator=1
  fi
  i=$((i + 1))
done

# ⛔ **new-session のときだけ書く。** アプリは `set-option` / `show-options` など
# 別のサブコマンドでもこのシムを呼ぶ（周11-b で `update-environment` の設定が入った）。
# それらは `-s` を持たないので、無条件に書くと**空文字で上書きしてしまい**、
# spec が「tmux セッション名が空」で落ちる（実際に踏んだ）。
if [ -n "${AI_TERMINAL_E2E_FIXTURES:-}" ] && [ "${1:-}" = "new-session" ]; then
  printf '%s' "$session" > "${AI_TERMINAL_E2E_FIXTURES}/tmux-session-name.txt"
fi

if [ "${#command_args[@]}" -eq 0 ]; then
  echo "fake tmux: -- 以降に実行すべきコマンドが見つかりません" >&2
  exit 1
fi

exec "${command_args[@]}"
