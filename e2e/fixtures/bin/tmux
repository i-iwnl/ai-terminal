#!/usr/bin/env bash
# E2E 用の偽 tmux。
#
# 本物の tmux を呼ぶとテストが非決定的になる（実行中の実セッションを拾う、
# E2E 実行のたびにセッションが衝突する等）うえ、本物の tmux は代替画面
# バッファへ切り替える（ESC [ ? 1049 h）ため、xterm 側のスクロールバックが
# 実装と無関係な理由で変化する。PATH の先頭にこのスクリプトを置いて差し替える。
#
# 重要: 受け取るのは常に
#   new-session -A -s <sessionName> -- <command> <args...>
# の形（src/main/pty/tmux.ts の wrapCommandWithTmux が組み立てる）。
# `-- ` より後ろをそのまま exec することで、ラップの中身（本物の claude /
# gemini の起動）まで含めて動かす。
#
# セッション名は ${AI_TERMINAL_E2E_FIXTURES}/tmux-session-name.txt に書き出す。
# spec 側はこのファイルを読むことで、アプリが渡した tmux セッション名
# （aiterm-<agentSessionId> の形）を検証できる。
#
# このシムで担保できないこと（本物の tmux との差）:
# - 代替画面バッファへの切り替えは行わない。
# - セッションの永続化は再現しない（このプロセスは exec するだけで、
#   親プロセスを kill してもセッションが生き残る、という tmux 本来の
#   挙動は無い）。
# - `-A`（同名セッションがあれば attach、無ければ new-session）の分岐は
#   検証していない。常に「新規にコマンドを exec する」動きしかしない。
#
# list-sessions は上記と別に扱う（下を参照）。**一覧の中身はフィクスチャが決める**ので、
# 「アプリが一覧をどう読むか」は検証できるが、「実際にアタッチできるか」は検証できない。

set -uo pipefail

# list-sessions: 生きているセッションの一覧。
# アプリ（poller.ts -> tmuxSessions.ts）が3秒ごとに叩く。
# ${AI_TERMINAL_E2E_FIXTURES}/tmux-live-sessions.txt があればその中身を返し、
# 無ければ本物の tmux が「サーバが動いていない」ときと同じく非ゼロで終わる。
# spec 側はこのファイルを書くことで「セッションが生き残っている」状態を作れる。
# list-panes: 生きているセッションの要約（session_name / 起動コマンド / cwd）。
# アプリ（poller.ts -> tmuxSessions.ts）が3秒ごとに叩く。
# ${AI_TERMINAL_E2E_FIXTURES}/tmux-live-panes.txt の中身をそのまま返す。
# **区切りは 0x1f**（実装の FIELD_SEPARATOR と合わせること）。
if [ "${1:-}" = "list-panes" ]; then
  live="${AI_TERMINAL_E2E_FIXTURES:-}/tmux-live-panes.txt"
  if [ -n "${AI_TERMINAL_E2E_FIXTURES:-}" ] && [ -f "$live" ]; then
    cat "$live"
    exit 0
  fi
  echo "no server running" >&2
  exit 1
fi

if [ "${1:-}" = "list-sessions" ]; then
  live="${AI_TERMINAL_E2E_FIXTURES:-}/tmux-live-sessions.txt"
  if [ -n "${AI_TERMINAL_E2E_FIXTURES:-}" ] && [ -f "$live" ]; then
    cat "$live"
    exit 0
  fi
  echo "no server running" >&2
  exit 1
fi

session=""
args=("$@")
command_args=()
found_separator=0

i=0
while [ "$i" -lt "$#" ]; do
  arg="${args[$i]}"
  if [ "$found_separator" -eq 1 ]; then
    command_args+=("$arg")
  elif [ "$arg" = "-s" ]; then
    i=$((i + 1))
    session="${args[$i]:-}"
  elif [ "$arg" = "--" ]; then
    found_separator=1
  fi
  i=$((i + 1))
done

# ⛔ **new-session のときだけ書く。** アプリは `set-option` / `show-options` など
# 別のサブコマンドでもこのシムを呼ぶ（周11-b で `update-environment` の設定が入った）。
# それらは `-s` を持たないので、無条件に書くと**空文字で上書きしてしまい**、
# spec が「tmux セッション名が空」で落ちる（実際に踏んだ）。
if [ -n "${AI_TERMINAL_E2E_FIXTURES:-}" ] && [ "${1:-}" = "new-session" ]; then
  printf '%s' "$session" > "${AI_TERMINAL_E2E_FIXTURES}/tmux-session-name.txt"
fi

if [ "${#command_args[@]}" -eq 0 ]; then
  echo "fake tmux: -- 以降に実行すべきコマンドが見つかりません" >&2
  exit 1
fi

exec "${command_args[@]}"
