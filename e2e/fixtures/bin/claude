#!/usr/bin/env bash
# E2E 用の偽 claude CLI。
#
# 本物の claude を呼ぶとテストが非決定的になり（実行中の実セッションを拾う）、
# スクリーンショットに実プロジェクト名や実プロンプトが写り込む。
# PATH の先頭にこのスクリプトを置いて差し替える。
#
# 重要: 対話起動時は受け取った引数をそのまま出力する。
# これによりアプリが --session-id / --resume を正しく渡したかを検証できる。

set -uo pipefail

# agents --json: 実行中セッション一覧（固定）
if [ "${1:-}" = "agents" ]; then
  # 取得失敗を再現したいテスト向けのスイッチ
  if [ "${AI_TERMINAL_E2E_AGENTS_FAIL:-}" = "1" ]; then
    echo "fake claude: agents の取得に失敗しました" >&2
    exit 1
  fi
  # 0件を再現したいテスト向けのスイッチ
  if [ "${AI_TERMINAL_E2E_AGENTS_EMPTY:-}" = "1" ]; then
    echo "[]"
    exit 0
  fi

  # --cwd <path>: そのパス配下で開始されたセッションだけに絞る。
  # 本物の claude も同じ挙動（help には "background sessions" とあるが、
  # 実機では interactive なセッションにも効くことを確認済み）。
  # ここを素通りさせると、絞り込みが壊れていてもテストが緑になる。
  scope=""
  while [ "$#" -gt 0 ]; do
    if [ "$1" = "--cwd" ]; then
      scope="${2:-}"
      break
    fi
    shift
  done

  if [ -n "$scope" ]; then
    # node は PATH に載っていない（隔離のため最小限のシステムパスしか残していない）。
    # ハーネスが絶対パスを AI_TERMINAL_E2E_NODE で渡す。
    "${AI_TERMINAL_E2E_NODE:-node}" -e '
      const [file, scope] = process.argv.slice(1);
      const all = JSON.parse(require("node:fs").readFileSync(file, "utf8"));
      // scope 自身と、その配下を採用する（前方一致だけだと /tmp/other が /tmp に混ざる）
      const under = (cwd) =>
        typeof cwd === "string" && (cwd === scope || cwd.startsWith(scope.replace(/\/$/, "") + "/"));
      process.stdout.write(JSON.stringify(all.filter((a) => under(a.cwd)), null, 2) + "\n");
    ' "${AI_TERMINAL_E2E_FIXTURES}/agents.json" "$scope"
    exit 0
  fi

  cat "${AI_TERMINAL_E2E_FIXTURES}/agents.json"
  exit 0
fi

if [ "${1:-}" = "--version" ]; then
  echo "0.0.0-e2e-fake (Claude Code)"
  exit 0
fi

# 対話モード: 受け取った引数を出力してから、入力を待ち続ける
#
# **--session-id の値は画面に出さない**（Issue #121 B-2）。
# アプリは起動のたびに randomUUID() で採番するので、そのまま出すと
# docs/images/ の中身が撮るたびに変わる。実測では13枚中2枚（S09 / S56）が
# これだけの理由で非決定的だった。**画素で「画像が実装とずれたか」を
# 検出したいので、非決定性は撮影時に隠すのではなく発生源で断つ。**
#
# 実際の値は fixtures ディレクトリへ書き出す。検証したい spec は画面ではなく
# そちらを読む（画面をパースするより堅い）。
ARGS_FOR_DISPLAY="$*"
SESSION_ID=""
PREV=""
for ARG in "$@"; do
  if [ "$PREV" = "--session-id" ]; then
    SESSION_ID="$ARG"
  fi
  PREV="$ARG"
done
if [ -n "$SESSION_ID" ]; then
  if [ -n "${AI_TERMINAL_E2E_FIXTURES:-}" ]; then
    printf '%s' "$SESSION_ID" > "${AI_TERMINAL_E2E_FIXTURES}/claude-session-id.txt"
  fi
  ARGS_FOR_DISPLAY="${ARGS_FOR_DISPLAY//$SESSION_ID/<session-id>}"
fi

echo "FAKE CLAUDE READY"
echo "ARGS: $ARGS_FOR_DISPLAY"
printf 'claude> '

while IFS= read -r line; do
  case "$line" in
    exit) echo "bye"; exit 0 ;;
    *) echo "echo: $line"; printf 'claude> ' ;;
  esac
done
